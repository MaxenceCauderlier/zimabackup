APP_ENV=dev
APP_DEBUG=1
APP_PORT=8090
TZ=Europe/Paris

# Development defaults keep Docker away from the host's real /DATA and /media.
# On ZimaOS, set these to /DATA and /media.
ZIMABACKUP_DATA_PATH=./dev-data
ZIMABACKUP_MEDIA_PATH=./dev-media

WORKER_INTERVAL=5

# Docker/ZimaOS application discovery (worker only).
APP_DISCOVERY_INTERVAL=120
DOCKER_SOCKET_PATH=/var/run/docker.sock
