# Prebuilt-image deployment (docker-compose.ghcr.yml)
ZIMABACKUP_IMAGE=ghcr.io/MaxenceCauderlier/zimabackup:0.15.1
APP_PORT=8090
TZ=Europe/Paris

# ZimaOS defaults. Change only for a non-standard test environment.
ZIMABACKUP_STORAGE_PATH=/DATA/AppData/ZimaBackup
ZIMABACKUP_DATA_PATH=/DATA
ZIMABACKUP_MEDIA_PATH=/media
ZIMAOS_APPS_PATH=/var/lib/casaos/apps
DOCKER_SOCKET_PATH=/var/run/docker.sock

WORKER_INTERVAL=5
APP_DISCOVERY_INTERVAL=120
