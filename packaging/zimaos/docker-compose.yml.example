name: zimabackup

services:
  zimabackup:
    image: ghcr.io/CHANGE_ME/zimabackup:0.4.0
    restart: unless-stopped
    ports:
      - target: 80
        published: "8090"
        protocol: tcp
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      TZ: Europe/Paris
      RESTIC_CACHE_DIR: /var/www/html/storage/cache/restic
    volumes:
      - /DATA/AppData/zimabackup:/var/www/html/storage
      - /DATA:/DATA:ro
      - /media:/media:ro

  worker:
    image: ghcr.io/CHANGE_ME/zimabackup:0.4.0
    restart: unless-stopped
    command: ["php", "bin/worker.php"]
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      TZ: Europe/Paris
      RESTIC_CACHE_DIR: /var/www/html/storage/cache/restic
      WORKER_INTERVAL: "5"
    volumes:
      - /DATA/AppData/zimabackup:/var/www/html/storage
      - /DATA:/DATA
      - /media:/media

x-casaos:
  id: com.zimabackup.app
  main: zimabackup
  index: /
  port_map: "8090"
  scheme: http
  icon: https://CHANGE_ME/icon.svg
  title:
    en_US: ZimaBackup
  tagline:
    en_US: Simple Restic backups for ZimaOS
  description:
    en_US: Create, run, verify and restore encrypted backups from a ZimaOS-friendly interface.
  author: CHANGE_ME
  developer: ZimaBackup
  category: Utilities
  architectures:
    - amd64
  version: "0.4.0"
  update_at: "2026-09-04"
  release_notes:
    en_US: Manual backup jobs, live Restic progress and run history.
