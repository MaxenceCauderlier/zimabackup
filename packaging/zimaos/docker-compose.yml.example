name: zimabackup

services:
  zimabackup:
    image: ghcr.io/maxencecauderlier/zimabackup:0.15.2
    restart: unless-stopped
    labels:
      org.zimabackup.internal: "true"
    ports:
      - target: 80
        published: "${WEBUI_PORT:-8090}"
        protocol: tcp
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      TZ: "${TZ:-Europe/Paris}"
      RESTIC_CACHE_DIR: /var/www/html/storage/cache/restic
    volumes:
      - /DATA/AppData/ZimaBackup:/var/www/html/storage
      - /DATA:/DATA:ro
      - /media:/media:ro

  worker:
    image: ghcr.io/maxencecauderlier/zimabackup:0.15.2
    restart: unless-stopped
    labels:
      org.zimabackup.internal: "true"
    command: ["php", "bin/worker.php"]
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      TZ: "${TZ:-Europe/Paris}"
      RESTIC_CACHE_DIR: /var/www/html/storage/cache/restic
      WORKER_INTERVAL: "5"
      APP_DISCOVERY_INTERVAL: "120"
      DOCKER_SOCKET: /var/run/docker.sock
      ZIMABACKUP_COMPOSE_PROJECT: zimabackup
      ZIMAOS_APPS_ROOT: /var/lib/casaos/apps
    volumes:
      - /DATA/AppData/ZimaBackup:/var/www/html/storage
      - /DATA:/DATA
      - /media:/media
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/casaos/apps:/var/lib/casaos/apps:ro

x-casaos:
  id: com.zimabackup.app
  main: zimabackup
  index: /
  port_map: "${WEBUI_PORT:-8090}"
  scheme: http
  icon: https://raw.githubusercontent.com/maxencecauderlier/zimabackup/main/packaging/zimaos/icon.svg
  title:
    en_US: ZimaBackup
    fr_FR: ZimaBackup
  tagline:
    en_US: Simple application-aware backups and disaster recovery for ZimaOS.
    fr_FR: Sauvegarde simple des applications et restauration après sinistre pour ZimaOS.
  description:
    en_US: |-
      ZimaBackup protects files and installed ZimaOS applications using encrypted recovery points. It can back up selected data, inspect recovery points, restore files and application data, and preserve the installed ZimaOS application definition for disaster recovery.
    fr_FR: |-
      ZimaBackup protège les fichiers et les applications ZimaOS installées grâce à des points de récupération chiffrés. Il permet de sauvegarder les données sélectionnées, parcourir les points de récupération, restaurer des fichiers et des données applicatives, et conserver la définition ZimaOS installée pour une restauration après sinistre.
  tips:
    before_install:
      en_US: |-
        ZimaBackup needs privileged access to Docker and write access to /DATA and /media so it can back up and restore applications. The web interface does not receive the Docker socket; only the background worker does.
      fr_FR: |-
        ZimaBackup a besoin d'un accès privilégié à Docker et d'un accès en écriture à /DATA et /media pour sauvegarder et restaurer les applications. L'interface Web ne reçoit pas le socket Docker ; seul le worker en arrière-plan y accède.
  author: ZimaBackup
  developer: ZimaBackup
  category: Productivity
  architectures:
    - amd64
  version: "0.15.2"
  update_at: "2026-10-01"
  release_notes:
    en_US: ZimaOS/CasaOS package aligned with the current top-level x-casaos application schema and dynamic WEBUI_PORT support.
    fr_FR: Package ZimaOS/CasaOS aligné sur le schéma x-casaos actuel et prise en charge du port WEBUI_PORT dynamique.
  website: https://github.com/maxencecauderlier/zimabackup
  repo: https://github.com/maxencecauderlier/zimabackup
  support: https://github.com/maxencecauderlier/zimabackup/issues
  docs: https://github.com/maxencecauderlier/zimabackup#readme
