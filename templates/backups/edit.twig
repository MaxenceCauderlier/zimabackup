{% extends "layout.twig" %}

{% block title %}Edit {{ job.name }} - {{ APP.name }}{% endblock %}

{% block content %}
<header class="page-header compact-header">
    <div>
        <a class="back-link" href="{{ ROUTER.generate('backups.show', {uuid: job.uuid}) }}">← {{ job.name }}</a>
        <p class="eyebrow">Backup settings</p>
        <h1>Edit backup job</h1>
        <p class="muted">Change the job name, state and manual folder sources. Protected application selections are preserved.</p>
    </div>
</header>

{% if errors %}
    <div class="alert alert-error"><strong>Unable to save</strong>{% for error in errors %}<div>{{ error }}</div>{% endfor %}</div>
{% endif %}

<form method="post" action="{{ ROUTER.generate('backups.update', {uuid: job.uuid}) }}">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div class="content-grid two-col-grid">
        <section class="panel form-panel-v2 stack-form">
            <div class="section-label"><span>1</span><div><strong>General</strong><small>Basic job configuration.</small></div></div>
            <label class="field">
                <span>Backup name</span>
                <input type="text" name="name" maxlength="100" value="{{ job.name }}" required>
            </label>
            <label class="toggle-line">
                <input type="checkbox" name="enabled" value="1" {{ job.enabled ? 'checked' : '' }}>
                <span><strong>Job enabled</strong><small>Disabled jobs cannot be launched until enabled again.</small></span>
            </label>
            <label class="field">
                <span>Repository</span>
                <select name="repository_id" required>
                    {% for repository in repositories %}
                        <option value="{{ repository.id }}" {{ job.repository_id == repository.id ? 'selected' : '' }}>{{ repository.name }} — {{ repository.path }}</option>
                    {% endfor %}
                </select>
                {% if job.runs is not empty %}<small>Once a job has run, changing its repository is blocked to preserve historical snapshot references.</small>{% endif %}
            </label>
        </section>

        <section class="panel form-panel-v2 stack-form">
            <div class="section-label"><span>2</span><div><strong>Folder sources</strong><small>Application mounts remain unchanged in this milestone.</small></div></div>
            <div class="source-list" data-source-list>
                {% for source in job.sources %}
                    <div class="source-row">
                        <input type="text" name="sources[]" value="{{ source.path }}" placeholder="/DATA/Documents">
                        <button type="button" class="icon-button" data-remove-source aria-label="Remove source">×</button>
                    </div>
                {% else %}
                    <div class="source-row">
                        <input type="text" name="sources[]" value="" placeholder="/DATA/Documents">
                        <button type="button" class="icon-button" data-remove-source aria-label="Remove source">×</button>
                    </div>
                {% endfor %}
            </div>
            <button type="button" class="button button-secondary" data-add-source>Add folder source</button>
            {% if job.applications is not empty %}
                <div class="info-strip compact-strip"><strong>{{ job.applications|length }} protected application{{ job.applications|length == 1 ? '' : 's' }}</strong><p>Application selections are preserved. Full application-selection editing will come with the scheduling/retention milestone.</p></div>
            {% endif %}
        </section>
    </div>
    <div class="form-actions page-form-actions">
        <a class="button button-secondary" href="{{ ROUTER.generate('backups.show', {uuid: job.uuid}) }}">Cancel</a>
        <button class="button" type="submit">Save changes</button>
    </div>
</form>
{% endblock %}
