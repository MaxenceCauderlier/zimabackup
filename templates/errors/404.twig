{% extends "layout.twig" %}

{% block title %}404 - {{ APP.name }}{% endblock %}

{% block content %}
<section class="panel empty-state large-empty-state top-gap">
    <div class="empty-illustration"><span>404</span></div>
    <h1>{{ t("Page not found") }}</h1>
    <p>{{ t("The requested page does not exist.") }}</p>
    <a class="button" href="{{ ROUTER.generate('dashboard') }}">{{ t("Back to dashboard") }}</a>
</section>
{% endblock %}
