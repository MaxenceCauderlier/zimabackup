{% extends "layout.twig" %}

{% block title %}Session expired - {{ APP.name }}{% endblock %}

{% block content %}
<section class="panel">
    <div class="empty-state">
        <strong>419 - Invalid or expired form token</strong>
        <p>Reload the form and try again.</p>
        <a class="button" href="{{ ROUTER.generate("repositories.create") }}">Back to repository form</a>
    </div>
</section>
{% endblock %}
