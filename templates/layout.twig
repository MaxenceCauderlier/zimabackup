<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f6f3">
    <title>{% block title %}{{ APP.name }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body>
<div class="shell">
    <aside class="rail">
        <a class="wordmark" href="{{ ROUTER.generate('dashboard') }}">
            <span class="wordmark-mark">ZB</span>
            <span>{{ APP.name }}</span>
        </a>

        <nav class="rail-nav" aria-label="Primary navigation">
            <a class="{{ CURRENT_PATH == '/' ? 'active' : '' }}" href="{{ ROUTER.generate('dashboard') }}">Overview</a>
            <a class="{{ CURRENT_PATH starts with '/backups' ? 'active' : '' }}" href="{{ ROUTER.generate('backups') }}">Backups</a>
            <a class="{{ CURRENT_PATH starts with '/repositories' ? 'active' : '' }}" href="{{ ROUTER.generate('repositories') }}">Repositories</a>
            <a class="{{ (CURRENT_PATH starts with '/snapshots' or CURRENT_PATH starts with '/restores' or CURRENT_PATH starts with '/application-restores' or CURRENT_PATH starts with '/snapshot-applications') ? 'active' : '' }}" href="{{ ROUTER.generate('snapshots') }}">Restore</a>
            <a class="{{ CURRENT_PATH starts with '/applications' ? 'active' : '' }}" href="{{ ROUTER.generate('applications') }}">Applications</a>
            <a class="{{ CURRENT_PATH starts with '/settings' ? 'active' : '' }}" href="{{ ROUTER.generate('settings') }}">Settings</a>
        </nav>

        <div class="rail-foot">
            <span class="quiet-dot"></span>
            <span>local worker</span>
        </div>
    </aside>

    <main class="main">
        <div class="main-inner">
            {% block content %}{% endblock %}
        </div>
    </main>
</div>
<script src="/assets/js/app.js" defer></script>
</body>
</html>
