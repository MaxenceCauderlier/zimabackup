<!doctype html>
<html lang="{{ LOCALE }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f6f3">
    <title>{% block title %}{{ APP.name }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body>
<div class="shell">
    <aside class="rail">
        <a class="wordmark" href="{{ ROUTER.generate('dashboard') }}">
            <span class="wordmark-mark">ZB</span>
            <span>{{ APP.name }}</span>
        </a>

        <nav class="rail-nav" aria-label="{{ t('Primary navigation') }}">
            <a class="{{ CURRENT_PATH == '/' ? 'active' : '' }}" href="{{ ROUTER.generate('dashboard') }}">{{ t("Overview") }}</a>
            <a class="{{ CURRENT_PATH starts with '/backups' ? 'active' : '' }}" href="{{ ROUTER.generate('backups') }}">{{ t("Backups") }}</a>
            <a class="{{ CURRENT_PATH starts with '/repositories' ? 'active' : '' }}" href="{{ ROUTER.generate('repositories') }}">{{ t("Storage") }}</a>
            <a class="{{ (CURRENT_PATH starts with '/snapshots' or CURRENT_PATH starts with '/restores' or CURRENT_PATH starts with '/application-restores' or CURRENT_PATH starts with '/snapshot-applications') ? 'active' : '' }}" href="{{ ROUTER.generate('snapshots') }}">{{ t("Restore") }}</a>
            <a class="{{ CURRENT_PATH starts with '/applications' ? 'active' : '' }}" href="{{ ROUTER.generate('applications') }}">{{ t("Applications") }}</a>
            <a class="{{ CURRENT_PATH starts with '/activity' ? 'active' : '' }}" href="{{ ROUTER.generate('activity') }}">{{ t("Activity") }}</a>
            <a class="{{ CURRENT_PATH starts with '/settings' ? 'active' : '' }}" href="{{ ROUTER.generate('settings') }}">{{ t("Settings") }}</a>
        </nav>

        <div class="rail-foot">
            <span class="quiet-dot"></span>
            <span>{{ t("local worker") }}</span>
        </div>
    </aside>

    <main class="main">
        <div class="main-inner">
            {% block content %}{% endblock %}
        </div>
    </main>
</div>
<script>window.ZB_I18N = {{ JS_I18N|json_encode|raw }};</script>
<script src="/assets/js/app.js" defer></script>
</body>
</html>
