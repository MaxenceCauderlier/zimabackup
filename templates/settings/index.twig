{% extends "layout.twig" %}

{% block title %}{{ t("Settings -") }} {{ APP.name }}{% endblock %}

{% block content %}
<header class="page-header"><div><h1>{{ t("Settings") }}</h1><p class="muted">{{ t("Defaults and background maintenance. Changes are read by the worker automatically.") }}</p></div></header>

{% if flash_success %}<div class="alert alert-success">{{ flash_success|trans }}</div>{% endif %}
{% if flash_error %}<div class="alert alert-error"><strong>{{ t("Unable to save") }}</strong><div>{{ flash_error|trans }}</div></div>{% endif %}

<form method="post" action="{{ ROUTER.generate('settings.update') }}" class="stack-form">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">


    <section class="simple-section">
        <div class="simple-section-head"><h2>{{ t("Interface") }}</h2></div>
        <div class="panel stack-form">
            <label class="field">
                <span>{{ t("Language") }}</span>
                <select name="ui_language">
                    {% for code, label in languages %}
                        <option value="{{ code }}" {{ values['ui.language'] == code ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <small>{{ t("The interface language changes after saving settings. Missing translations fall back to English.") }}</small>
            </label>
        </div>
    </section>

    <section class="simple-section">
        <div class="simple-section-head"><h2>{{ t("Restore paths") }}</h2></div>
        <div class="panel stack-form">
            <label class="field"><span>{{ t("File restore root") }}</span><input type="text" name="restore_default_root" value="{{ values['restore.default_root'] }}"><small>{{ t("New file restores are created below this directory.") }}</small></label>
            <label class="field"><span>{{ t("Application staging root") }}</span><input type="text" name="application_restore_default_root" value="{{ values['application_restore.default_root'] }}"><small>{{ t("Safe staging area used before original-path application restores.") }}</small></label>
        </div>
    </section>

    <section class="simple-section">
        <div class="simple-section-head"><h2>{{ t("Discovery") }}</h2></div>
        <div class="panel stack-form">
            <label class="field"><span>{{ t("Application discovery interval") }}</span><input type="number" min="30" max="3600" name="apps_discovery_interval" value="{{ values['apps.discovery.interval'] }}"><small>{{ t("Seconds between automatic Docker discovery passes.") }}</small></label>
        </div>
    </section>

    <section class="simple-section">
        <div class="simple-section-head"><h2>{{ t("Activity history") }}</h2></div>
        <div class="panel stack-form">
            <label class="field"><span>{{ t("Keep activity for") }}</span><input type="number" min="1" max="3650" name="activity_retention_days" value="{{ values['activity.retention_days'] }}"><small>{{ t("Days. Older events are removed automatically by the worker.") }}</small></label>
            <label class="field"><span>{{ t("Maximum events") }}</span><input type="number" min="100" max="100000" name="activity_max_events" value="{{ values['activity.max_events'] }}"><small>{{ t("A second safety limit prevents the activity database from growing indefinitely.") }}</small></label>
        </div>
    </section>

    <section class="simple-section">
        <div class="simple-section-head"><h2>{{ t("Storage maintenance") }}</h2></div>
        <div class="panel stack-form">
            <label class="toggle-line"><input type="checkbox" name="maintenance_auto_check" value="1" {{ values['maintenance.auto_check'] == '1' ? 'checked' : '' }}><span><strong>{{ t("Automatic backup checks") }}</strong><small>{{ t("Periodically verify that backup storage is readable and internally consistent.") }}</small></span></label>
            <label class="field"><span>{{ t("Check every") }}</span><input type="number" min="1" max="365" name="maintenance_check_interval_days" value="{{ values['maintenance.check_interval_days'] }}"><small>{{ t("Days.") }}</small></label>
            <label class="toggle-line"><input type="checkbox" name="maintenance_auto_prune" value="1" {{ values['maintenance.auto_prune'] == '1' ? 'checked' : '' }}><span><strong>{{ t("Automatically free unused space") }}</strong><small>{{ t("Disabled by default. When enabled, ZimaBackup periodically removes backup data that is no longer used by any recovery point.") }}</small></span></label>
            <label class="field"><span>{{ t("Free unused space every") }}</span><input type="number" min="1" max="365" name="maintenance_prune_interval_days" value="{{ values['maintenance.prune_interval_days'] }}"><small>{{ t("Days. You can also free unused space manually from Storage.") }}</small></label>
            <div class="alert alert-info"><strong>{{ t("What does “Free unused space” do?") }}</strong><div>{{ t("Deleting a recovery point removes it from restore history, but some shared backup data can remain on disk. Freeing unused space permanently removes only data that is no longer needed by any remaining recovery point.") }}</div></div>
        </div>
    </section>

    <div class="form-actions"><button class="button" type="submit">{{ t("Save settings") }}</button></div>
</form>

<section class="simple-section">
    <div class="simple-section-head"><h2>{{ t("ZimaOS integration") }}</h2></div>
    <div class="simple-row"><div><strong>{{ t("Installed application definitions") }}</strong><small><code>{{ zimaos_integration.root }}</code></small></div><div class="simple-row-meta">{{ zimaos_integration.available ? t("Available") : t("Unavailable") }}</div></div>
    <div class="empty-inline"><p>{{ t("When available, ZimaBackup preserves the exact installed Docker Compose file and x-casaos metadata in the encrypted backup. Docker Inspect remains as a recovery fallback.") }}</p></div>
</section>

<section class="simple-section">
    <div class="simple-section-head"><h2>{{ t("Runtime") }}</h2></div>
    <div class="simple-row"><div><strong>ZimaBackup</strong><small>{{ t("Installed application version.") }}</small></div><div class="simple-row-meta">{{ version }}</div></div>
    <div class="simple-row"><div><strong>{{ t("Backup engine (Restic)") }}</strong><small>{{ t("Technical component used internally by ZimaBackup.") }}</small></div><div class="simple-row-meta">{{ restic_version ?: t('unavailable') }}</div></div>
    <div class="simple-row"><div><strong>{{ t("Docker socket") }}</strong><small>{{ t("Used only by the privileged worker.") }}</small></div><div class="simple-row-meta"><code>{{ docker_socket }}</code></div></div>
</section>
{% endblock %}
