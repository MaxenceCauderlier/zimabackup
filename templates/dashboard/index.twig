{% extends "layout.twig" %}

{% block title %}Overview - {{ APP.name }}{% endblock %}

{% block content %}
<section class="overview-state">
    {% if attention > 0 %}
        <h1>{{ attention }} item{{ attention == 1 ? '' : 's' }} need attention.</h1>
        <p>Open the relevant backup or repository before relying on the next recovery point.</p>
    {% elseif repository_count == 0 %}
        <h1>No backup destination yet.</h1>
        <p>Create a repository first, then define what ZimaBackup should protect.</p>
    {% else %}
        <h1>Everything looks quiet.</h1>
        <p>
            {% if last_success %}Last successful backup: {{ last_success.job_name }} · {{ last_success.finished_at }}.{% else %}No successful backup has been recorded yet.{% endif %}
            {% if next_job %} Next scheduled run: {{ next_job.name }} · {{ next_job.next_run_at }}.{% endif %}
        </p>
    {% endif %}

    <div class="overview-actions">
        <a class="button" href="{{ ROUTER.generate('backups.create') }}">New backup</a>
        <a class="button-secondary" href="{{ ROUTER.generate('snapshots') }}">Restore</a>
        <a class="button-secondary" href="{{ ROUTER.generate('repositories.create') }}">Add repository</a>
    </div>
</section>

<section class="simple-section">
    <div class="simple-section-head">
        <h2>Backup jobs</h2>
        <a class="text-link" href="{{ ROUTER.generate('backups') }}">View all</a>
    </div>
    {% for job in jobs %}
        <a class="simple-row" href="{{ ROUTER.generate('backups.show', {uuid: job.uuid}) }}">
            <div>
                <strong>{{ job.name }}</strong>
                <small>{{ job.repository_name }} · {{ job.schedule_type == 'manual' ? 'manual' : job.schedule_type }}</small>
            </div>
            <div class="simple-row-meta">
                {% if not job.enabled %}disabled{% elseif job.next_run_at %}next {{ job.next_run_at }}{% else %}{{ job.latest_status ?: 'not run yet' }}{% endif %}
            </div>
        </a>
    {% else %}
        <div class="empty-inline"><strong>No backup jobs</strong><p>Create one when your first repository is ready.</p></div>
    {% endfor %}
</section>

<section class="simple-section">
    <div class="simple-section-head">
        <h2>Recent activity</h2>
        <span class="muted">Restic: {{ restic_version ?: 'unavailable' }}</span>
    </div>
    {% for run in recent_runs %}
        <a class="simple-row" href="{{ ROUTER.generate('backups.show', {uuid: run.job_uuid}) }}">
            <div>
                <strong>{{ run.job_name }}</strong>
                <small>{{ run.status }}{% if run.error %} · {{ run.error|slice(0, 100) }}{% endif %}</small>
            </div>
            <div class="simple-row-meta">{{ run.finished_at ?: run.started_at }}</div>
        </a>
    {% else %}
        <div class="empty-inline"><strong>No activity yet</strong><p>Backup runs will appear here.</p></div>
    {% endfor %}
</section>
{% endblock %}
