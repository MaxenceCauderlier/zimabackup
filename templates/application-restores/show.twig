{% extends "layout.twig" %}

{% block title %}Restore {{ restore.app_name }} - {{ APP.name }}{% endblock %}

{% block content %}
<header class="page-header compact-header">
    <div>
        <a class="back-link" href="{{ ROUTER.generate('restores') }}">← Restores</a>
        <p class="eyebrow">Application recovery</p>
        <h1>{{ restore.app_name }}</h1>
        <p class="muted">{{ restore.mode == 'original' ? 'Original paths mode' : 'Safe staging mode' }} · {{ restore.repository_name }}</p>
    </div>
    <span class="status-pill {{ restore.status == 'success' ? 'ok' : (restore.status in ['pending', 'running'] ? 'warning' : 'error') }}"><span class="status-dot"></span>{{ restore.status }}</span>
</header>

{% if flash_success %}<div class="alert alert-success">{{ flash_success }}</div>{% endif %}
{% if flash_error %}<div class="alert alert-error">{{ flash_error }}</div>{% endif %}
{% if restore.cleanup_error %}<div class="alert alert-error"><strong>Cleanup failed</strong><div>{{ restore.cleanup_error }}</div></div>{% endif %}

<section class="summary-cards four-summary-cards">
    <article class="summary-card"><span>Snapshot</span><strong>{{ restore.backup_run_id }}</strong></article>
    <article class="summary-card"><span>Mode</span><strong>{{ restore.mode }}</strong></article>
    <article class="summary-card"><span>Files restored</span><strong>{{ restore.files_restored|default(0) }}</strong></article>
    <article class="summary-card"><span>Data restored</span><strong>{{ restore.bytes_restored|bytes }}</strong></article>
</section>

{% if restore.status in ['pending', 'running'] %}
    <section class="panel live-panel" data-auto-refresh>
        <div class="live-panel-head">
            <div><span class="card-kicker">Worker operation</span><h2>{{ restore.status == 'pending' ? 'Waiting for worker' : 'Restoring selected application data' }}</h2></div>
            <strong>{{ restore.progress_percent|default(0)|number_format(0) }}%</strong>
        </div>
        <div class="progress-track large-track"><span style="width: {{ restore.progress_percent|default(0) }}%"></span></div>
        <div class="summary-cards three-summary-cards compact-summary-cards">
            <article class="summary-card"><span>Files</span><strong>{{ restore.files_restored|default(0) }} / {{ restore.total_files|default(0) }}</strong></article>
            <article class="summary-card"><span>Data</span><strong>{{ restore.bytes_restored|bytes }} / {{ restore.total_bytes|bytes }}</strong></article>
            <article class="summary-card"><span>Errors</span><strong>{{ restore.error_count|default(0) }}</strong></article>
        </div>
    </section>
{% elseif restore.status == 'failed' %}
    <section class="panel attention-panel">
        <span class="status-pill error"><span class="status-dot"></span>Restore failed safely</span>
        <h2>No existing data was intentionally overwritten</h2>
        <p>{{ restore.error }}</p>
        <p class="muted">The staging directory may contain partial recovered data for inspection: <code>{{ restore.staging_path }}</code></p>
    </section>
{% elseif restore.status == 'success' %}
    <section class="panel success-panel-v2">
        <div>
            <span class="status-pill ok"><span class="status-dot"></span>Restore complete</span>
            <h2>{{ restore.mode == 'original' ? 'Application data returned to original paths' : 'Application staged safely' }}</h2>
            <p>The selected snapshot data was restored and a Docker Compose definition was reconstructed.</p>
        </div>
    </section>
{% endif %}

<div class="content-grid two-col-grid">
    <section class="panel">
        <div class="panel-heading"><div><span class="card-kicker">Recovered workspace</span><h2>Staging</h2></div></div>
        <div class="detail-stack">
            <div class="detail-row-card wide-row-card"><div><strong>Staging path</strong><small>{{ restore.staging_path }}</small></div><span class="mini-tag eligible">worker only</span></div>
            <div class="detail-row-card wide-row-card"><div><strong>Compose file</strong><small>{{ restore.compose_path ?: 'Generated after data restore' }}</small></div><span class="mini-tag recommended">0600</span></div>
        </div>
        <div class="info-strip compact-strip">
            <strong>Contains secrets</strong>
            <p>The generated Compose file can contain original environment values. ZimaBackup does not render it in the browser.</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading"><div><span class="card-kicker">Original application data</span><h2>Paths</h2></div></div>
        <div class="detail-stack">
            {% for mount in restore.selected_mounts %}
                <div class="detail-row-card wide-row-card">
                    <div><strong>{{ mount.destination ?: 'Container mount' }}</strong><small>{{ mount.source }}</small></div>
                    {% if mount.source in restore.applied_paths %}<span class="mini-tag recommended">restored</span>{% else %}<span class="mini-tag eligible">staged</span>{% endif %}
                </div>
            {% else %}
                <div class="empty-inline"><strong>No selected data mount</strong><p>This application restore contains the reconstructed definition only.</p></div>
            {% endfor %}
        </div>
    </section>
</div>

{% if install_error %}
    <div class="alert alert-error"><strong>Application installation cannot start.</strong><div>{{ install_error }}</div></div>
{% endif %}

{% if install and install.status in ['pending', 'running'] %}
<section class="panel live-panel" data-auto-refresh>
    <div class="live-panel-head">
        <div>
            <span class="card-kicker">Restore & Install</span>
            <h2>{{ install.status == 'pending' ? 'Installation queued' : 'Recreating application' }}</h2>
            <p class="muted">Current stage: <strong>{{ install.stage ?: 'preparing' }}</strong></p>
        </div>
        <span class="status-pill warning"><span class="status-dot"></span>{{ install.status }}</span>
    </div>
    <div class="install-stage-track">
        {% for stage_name in ['preflight', 'pulling-images', 'creating-networks', 'creating-containers', 'starting-containers', 'verifying'] %}
            <span class="install-stage {{ install.stage == stage_name ? 'active' : '' }}">{{ stage_name|replace({'-': ' '}) }}</span>
        {% endfor %}
    </div>
</section>
{% elseif install and install.status == 'success' %}
<section class="panel success-panel-v2 install-result-panel">
    <div>
        <span class="status-pill ok"><span class="status-dot"></span>Application running</span>
        <h2>Restore & Install completed</h2>
        <p>ZimaBackup recreated the Docker application from the encrypted backup manifest and verified that the restored containers stayed running.</p>
    </div>
    <div class="summary-cards two-summary-cards compact-summary-cards">
        <article class="summary-card"><span>Project</span><strong>{{ install.project_name }}</strong></article>
        <article class="summary-card"><span>Containers</span><strong>{{ install.container_ids|length }}</strong></article>
    </div>
</section>
{% elseif install and install.status == 'failed' %}
<section class="panel attention-panel">
    <span class="status-pill error"><span class="status-dot"></span>Install failed</span>
    <h2>Docker objects were rolled back where possible</h2>
    <p>{{ install.error }}</p>
    <p class="muted">Restored application data was deliberately left in place so you can inspect it or retry after correcting the problem.</p>
</section>
{% elseif restore.status == 'success' and restore.mode == 'original' and not restore.cleaned_at %}
<section class="panel install-action-panel">
    <div class="panel-heading">
        <div>
            <span class="card-kicker">Final recovery step</span>
            <h2>Restore & Install</h2>
            <p class="muted">ZimaBackup can now pull missing images, recreate required Docker networks, create the backed-up containers and start them.</p>
        </div>
        <span class="status-pill warning"><span class="status-dot"></span>Docker write access</span>
    </div>

    <div class="info-strip compact-strip">
        <strong>Safety rules</strong>
        <p>An existing Docker application is never replaced. Bind mounts outside <code>/DATA</code> and <code>/media</code> are refused by default, named volumes are not installed automatically yet, and a failed install removes Docker objects created by that attempt without deleting restored data.</p>
    </div>

    <form method="post" action="{{ ROUTER.generate('application-restores.install', {uuid: restore.uuid}) }}" class="install-confirm-form">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label class="field">
            <span>Type INSTALL to confirm</span>
            <input type="text" name="confirm_install" autocomplete="off" placeholder="INSTALL" required>
            <small>This action creates and starts Docker containers on the host.</small>
        </label>
        <button class="button" type="submit">Restore & Install application</button>
    </form>
</section>
{% elseif restore.status == 'success' and restore.mode == 'staging' %}
<section class="panel">
    <span class="card-kicker">Installation unavailable</span>
    <h2>Original paths are required</h2>
    <p class="muted">This restore used Safe staging. Automatic installation remains disabled until the application's selected data paths have been restored to their original locations.</p>
</section>
{% elseif restore.status == 'success' and restore.mode == 'original' and restore.cleaned_at and not install %}
<div class="alert alert-warning"><strong>Staging was cleaned</strong><div>The restored AppData remains at its original paths, but automatic installation is no longer available from this restore because its encrypted manifest workspace was removed.</div></div>
{% endif %}

{% if restore.cleanup_status in ['queued', 'running'] %}
<section class="simple-section" data-auto-refresh>
    <div class="empty-inline"><strong>Cleaning staging…</strong><p>The worker is removing only the application restore workspace.</p></div>
</section>
{% elseif restore.cleaned_at %}
<section class="simple-section">
    <div class="empty-inline"><strong>Staging cleaned</strong><p>The application restore workspace was removed on {{ restore.cleaned_at }}. Original paths already applied by an original-mode restore were not deleted.</p></div>
</section>
{% elseif restore.status in ['success', 'failed'] and not (install and install.status in ['pending', 'running']) %}
<section class="simple-section">
    <div class="simple-section-head"><h2>Cleanup</h2></div>
    <div class="simple-row">
        <div><strong>Remove staging workspace</strong><small>{{ restore.staging_path }} · restored original AppData is not removed</small></div>
        <form method="post" action="{{ ROUTER.generate('application-restores.cleanup', {uuid: restore.uuid}) }}" data-confirm="Delete this application restore staging workspace? Original paths already restored will stay in place.">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <button class="button-secondary button-danger" type="submit">Clean staging</button>
        </form>
    </div>
</section>
{% endif %}
{% endblock %}
