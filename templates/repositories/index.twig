{% extends "layout.twig" %}

{% block title %}Repositories - {{ APP.name }}{% endblock %}

{% block content %}
<header class="page-header">
    <div><h1>Repositories</h1><p class="muted">Encrypted destinations used by backup jobs.</p></div>
    <a class="button" href="{{ ROUTER.generate('repositories.create') }}">Add repository</a>
</header>

{% if flash_success %}<div class="alert alert-success">{{ flash_success }}</div>{% endif %}
{% if flash_error %}<div class="alert alert-error"><strong>Repository action failed</strong><div>{{ flash_error }}</div></div>{% endif %}

{% if repositories is empty %}
    <div class="empty-inline"><strong>No repositories.</strong><p>Create one on a separate disk or storage location.</p></div>
{% else %}
    {% for repository in repositories %}
        <section class="simple-section">
            <div class="simple-section-head">
                <h2>{{ repository.name }}</h2>
                <span class="status-pill {{ repository.status == 'ready' ? 'ok' : (repository.status in ['initializing','reinitializing'] ? 'warning' : 'error') }}"><span class="status-dot"></span>{{ repository.status }}</span>
            </div>
            <div class="simple-row"><div><strong>{{ repository.path }}</strong><small>{{ repository.active_jobs }} active job{{ repository.active_jobs == 1 ? '' : 's' }}</small></div><div class="simple-row-meta">{{ repository.storage_present ? 'storage present' : 'storage missing' }}</div></div>
            <div class="simple-row"><div><strong>Integrity</strong><small>{{ repository.last_check_error ?: 'Repository verification state.' }}</small></div><div class="simple-row-meta">{{ repository.last_check_status ?: 'never checked' }}{% if repository.last_check_at %}<br>{{ repository.last_check_at }}{% endif %}</div></div>
            <div class="simple-row"><div><strong>Prune</strong><small>Reclaims unreferenced data after forgotten snapshots.</small></div><div class="simple-row-meta">{{ repository.last_prune_status ?: 'never' }}{% if repository.last_prune_at %}<br>{{ repository.last_prune_at }}{% endif %}</div></div>

            {% if repository.status == 'missing' %}
                <div class="alert alert-error"><strong>Repository storage is missing.</strong><div>{{ repository.error }}</div></div>
            {% endif %}

            <div class="form-actions">
                <form method="post" action="{{ ROUTER.generate('repositories.check', {uuid: repository.uuid}) }}"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="button-secondary" type="submit" {{ repository.running_operations > 0 or not repository.storage_present ? 'disabled' : '' }}>Check</button></form>
                <form method="post" action="{{ ROUTER.generate('repositories.prune', {uuid: repository.uuid}) }}" data-confirm="Prune this repository now? This can take a long time and reclaims data no longer referenced by snapshots."><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="button-secondary" type="submit" {{ repository.status != 'ready' or repository.running_operations > 0 or not repository.storage_present ? 'disabled' : '' }}>Prune</button></form>
                {% if repository.can_reinitialize %}<form method="post" action="{{ ROUTER.generate('repositories.reinitialize', {uuid: repository.uuid}) }}" data-confirm="Create a new empty Restic repository here with the existing recovery key? Historical snapshots will become unavailable."><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="button-secondary" type="submit">Reinitialize</button></form>{% endif %}
                <a class="button-secondary" href="{{ ROUTER.generate('repositories.edit', {uuid: repository.uuid}) }}">Rename</a>
                <form method="post" action="{{ ROUTER.generate('repositories.remove', {uuid: repository.uuid}) }}" data-confirm="Remove this repository from ZimaBackup? Backup data on disk will NOT be deleted."><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="button-secondary button-danger" type="submit" {{ repository.active_jobs > 0 or repository.running_operations > 0 ? 'disabled' : '' }}>Remove</button></form>
            </div>
        </section>
    {% endfor %}
{% endif %}
{% endblock %}
