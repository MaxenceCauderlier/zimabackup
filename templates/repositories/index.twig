{% extends "layout.twig" %}

{% block title %}Repositories - {{ APP.name }}{% endblock %}

{% block content %}
{% set ready_count = 0 %}
{% set failed_count = 0 %}
{% for repository in repositories %}
    {% if repository.status == 'ready' %}{% set ready_count = ready_count + 1 %}{% endif %}
    {% if repository.status == 'failed' %}{% set failed_count = failed_count + 1 %}{% endif %}
{% endfor %}

<header class="page-header hero-header">
    <div>
        <p class="eyebrow">Storage destinations</p>
        <h1>Repositories</h1>
        <p class="muted">Each repository is an encrypted Restic destination where snapshots are written and verified.</p>
    </div>
    <div class="header-actions">
        <span class="status-pill {{ failed_count > 0 ? 'warning' : 'ok' }}"><span class="status-dot"></span>{{ ready_count }} ready / {{ repositories|length }} total</span>
        <a class="button" href="{{ ROUTER.generate('repositories.create') }}">New repository</a>
    </div>
</header>

<section class="stats-grid slim-stats">
    <article class="panel stat-card"><span class="stat-title">Total repositories</span><strong>{{ repositories|length }}</strong><small>All configured destinations</small></article>
    <article class="panel stat-card"><span class="stat-title">Ready</span><strong>{{ ready_count }}</strong><small>Ready for backups</small></article>
    <article class="panel stat-card {{ failed_count > 0 ? 'warning-card' : '' }}"><span class="stat-title">Errors</span><strong>{{ failed_count }}</strong><small>{{ failed_count > 0 ? 'Need review' : 'None reported' }}</small></article>
</section>

{% if repositories is empty %}
    <section class="panel empty-state large-empty-state">
        <div class="empty-illustration"><span>⛁</span></div>
        <h2>Create your first repository</h2>
        <p>Pick a folder under <code>/DATA</code> or <code>/media</code>. ZimaBackup will initialize and verify the encrypted Restic repository for you.</p>
        <a class="button" href="{{ ROUTER.generate('repositories.create') }}">Create repository</a>
    </section>
{% else %}
    <section class="card-grid repository-grid-v2">
        {% for repository in repositories %}
            <article class="panel repository-card-v2">
                <div class="card-topline">
                    <div>
                        <span class="card-kicker">{{ repository.type|upper }}</span>
                        <h2>{{ repository.name }}</h2>
                    </div>
                    <span class="status-pill compact {{ repository.status == 'ready' ? 'ok' : (repository.status in ['pending', 'initializing'] ? 'warning' : 'error') }}"><span class="status-dot"></span>{{ repository.status }}</span>
                </div>
                <div class="storage-meter">
                    <div class="meter-bar"><span style="width: {{ repository.status == 'ready' ? 86 : (repository.status == 'initializing' ? 45 : 18) }}%"></span></div>
                    <div class="meter-labels"><span>{{ repository.status == 'ready' ? 'Ready for backups' : (repository.status == 'initializing' ? 'Initializing' : 'Needs attention') }}</span><span>{{ repository.running_operations }} op</span></div>
                </div>
                <dl class="detail-list">
                    <div><dt>Path</dt><dd><code>{{ repository.path }}</code></dd></div>
                    <div><dt>Password file</dt><dd><code>{{ repository.password_file|split('/')|last }}</code></dd></div>
                    <div><dt>Created</dt><dd>{{ repository.created_at }}</dd></div>
                </dl>
                {% if repository.error %}
                    <div class="inline-error">{{ repository.error }}</div>
                {% endif %}
                <div class="card-footer-note">Recovery key is shown once at creation and stored securely for worker access.</div>
            </article>
        {% endfor %}
    </section>
{% endif %}
{% endblock %}
