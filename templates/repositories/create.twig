{% extends "layout.twig" %}
{% block title %}{{ t("New backup storage -") }} {{ APP.name }}{% endblock %}
{% block content %}
<header class="page-header"><div><a class="back-link" href="{{ ROUTER.generate('repositories') }}">{{ t("← Storage") }}</a><h1>{{ t("New backup storage") }}</h1><p class="muted">{{ t("The destination must be absent or empty. ZimaBackup will prepare encrypted backup storage there.") }}</p></div></header>
{% if errors %}<div class="alert alert-error">{% for error in errors %}<div>{{ error|trans }}</div>{% endfor %}</div>{% endif %}
<form method="post" action="{{ ROUTER.generate('repositories.store') }}" class="panel stack-form">
<input type="hidden" name="_csrf" value="{{ csrf_token }}">
<label class="field"><span>{{ t("Name") }}</span><input type="text" name="name" value="{{ values.name }}" maxlength="100" required placeholder="{{ t('USB Backup') }}"></label>
<label class="field"><span>{{ t("Path") }}</span><input type="text" name="path" value="{{ values.path }}" required><small>{{ t("Example: /media/Backup/ZimaBackup") }}</small></label>
<div class="form-actions"><a class="button-secondary" href="{{ ROUTER.generate('repositories') }}">{{ t("Cancel") }}</a><button class="button" type="submit">{{ t("Add backup storage") }}</button></div>
</form>
{% endblock %}
