{% extends "layout.twig" %}

{% block title %}Snapshots - {{ APP.name }}{% endblock %}

{% block content %}
{% set forgetting_count = 0 %}
{% for snapshot in snapshots %}{% if snapshot.snapshot_state == 'forgetting' %}{% set forgetting_count = forgetting_count + 1 %}{% endif %}{% endfor %}

<header class="page-header hero-header">
    <div>
        <p class="eyebrow">Recovery points</p>
        <h1>Snapshots</h1>
        <p class="muted">Browse recovery points and explicitly forget snapshots you no longer want to retain.</p>
    </div>
</header>

{% if flash_success %}<div class="alert alert-success">{{ flash_success }}</div>{% endif %}
{% if flash_error %}<div class="alert alert-error"><strong>Snapshot action failed</strong><div>{{ flash_error }}</div></div>{% endif %}

{% if snapshots is empty %}
    <section class="panel empty-state large-empty-state">
        <div class="empty-illustration"><span>↺</span></div>
        <h2>No snapshots yet</h2>
        <p>Launch a backup successfully and the resulting recovery points will appear here.</p>
        <a class="button" href="{{ ROUTER.generate('backups') }}">Open backups</a>
    </section>
{% else %}
    <section class="snapshot-list-v2">
        {% for snapshot in snapshots %}
            <article class="panel snapshot-card-v2">
                <div class="card-topline">
                    <div><span class="card-kicker">{{ snapshot.repository_name }}</span><h2>{{ snapshot.job_name }}</h2></div>
                    <span class="status-pill compact {{ snapshot.snapshot_state == 'forgetting' ? 'warning' : (snapshot.status == 'warning' ? 'warning' : 'ok') }}"><span class="status-dot"></span>{{ snapshot.snapshot_state == 'forgetting' ? 'forgetting' : snapshot.status }}</span>
                </div>
                <div class="summary-cards mini-summary-cards">
                    <article class="summary-card"><span>Finished</span><strong>{{ snapshot.finished_at }}</strong></article>
                    <article class="summary-card"><span>Processed</span><strong>{{ snapshot.bytes_processed|bytes }}</strong></article>
                    <article class="summary-card"><span>Added</span><strong>{{ snapshot.bytes_added|bytes }}</strong></article>
                </div>
                {% if snapshot.snapshot_forget_error %}<div class="inline-error">Forget failed: {{ snapshot.snapshot_forget_error }}</div>{% endif %}
                <div class="snapshot-actions">
                    <code>{{ snapshot.snapshot_id|slice(0, 12) }}</code>
                    <div>
                        {% if not snapshot.job_deleted_at %}<a class="button button-secondary compact-button" href="{{ ROUTER.generate('backups.show', {uuid: snapshot.job_uuid}) }}">Open job</a>{% else %}<span class="mini-tag ignored">job deleted</span>{% endif %}
                        {% if snapshot.app_count > 0 %}<a class="button button-secondary compact-button" href="{{ ROUTER.generate('snapshots.applications', {runId: snapshot.id}) }}">Applications</a>{% endif %}
                        <a class="button compact-button" href="{{ ROUTER.generate('restores.create', {runId: snapshot.id}) }}">Restore files</a>
                        <form method="post" action="{{ ROUTER.generate('snapshots.forget', {runId: snapshot.id}) }}" data-confirm="Forget this snapshot from the Restic repository? This removes the recovery point. Repository compaction (prune) is a separate maintenance step.">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <button class="button danger-button compact-button" type="submit" {{ snapshot.snapshot_state == 'forgetting' ? 'disabled' : '' }}>Forget</button>
                        </form>
                    </div>
                </div>
            </article>
        {% endfor %}
    </section>
{% endif %}

{% if forgetting_count > 0 %}<div class="refresh-banner" data-auto-refresh><span class="spinner"></span> Snapshot removal is running. This page will refresh automatically.</div>{% endif %}
{% endblock %}
