{% extends "layout.twig" %}

{% block title %}Restore - {{ APP.name }}{% endblock %}

{% block content %}
{% set forgetting_count = 0 %}
{% for snapshot in snapshots %}{% if snapshot.snapshot_state == 'forgetting' %}{% set forgetting_count = forgetting_count + 1 %}{% endif %}{% endfor %}

<header class="page-header">
    <div><h1>Restore</h1><p class="muted">Choose a recovery point, then restore files or an application.</p></div>
    <a class="button-secondary" href="{{ ROUTER.generate('restores') }}">Restore history</a>
</header>

{% if flash_success %}<div class="alert alert-success">{{ flash_success }}</div>{% endif %}
{% if flash_error %}<div class="alert alert-error"><strong>Snapshot action failed</strong><div>{{ flash_error }}</div></div>{% endif %}

{% if snapshots is empty %}
    <div class="empty-inline"><strong>No recovery points.</strong><p>Successful backups will appear here.</p></div>
{% else %}
    <section class="panel">
    {% for snapshot in snapshots %}
        <div class="simple-row">
            <div>
                <strong>{{ snapshot.job_name }}</strong>
                <small>{{ snapshot.repository_name }} · {{ snapshot.finished_at }} · {{ snapshot.bytes_processed|bytes }} · <code>{{ snapshot.snapshot_id|slice(0, 12) }}</code></small>
                {% if snapshot.snapshot_forget_error %}<small style="color:var(--danger)">Forget failed: {{ snapshot.snapshot_forget_error }}</small>{% endif %}
                {% if snapshot.snapshot_state == 'unavailable' %}<small style="color:var(--danger)">{{ snapshot.snapshot_unavailable_reason ?: 'This snapshot is no longer available.' }}</small>{% endif %}
            </div>
            <div class="header-actions">
                <span class="status-pill {{ snapshot.snapshot_state == 'unavailable' ? 'error' : (snapshot.snapshot_state == 'forgetting' or snapshot.status == 'warning' ? 'warning' : 'ok') }}"><span class="status-dot"></span>{{ snapshot.snapshot_state == 'unavailable' ? 'unavailable' : (snapshot.snapshot_state == 'forgetting' ? 'forgetting' : snapshot.status) }}</span>
                {% if snapshot.snapshot_state != 'unavailable' %}
                    {% if snapshot.app_count > 0 %}<a class="button-secondary" href="{{ ROUTER.generate('snapshots.applications', {runId: snapshot.id}) }}">Application</a>{% endif %}
                    <a class="button" href="{{ ROUTER.generate('restores.create', {runId: snapshot.id}) }}">Files</a>
                    <form method="post" action="{{ ROUTER.generate('snapshots.forget', {runId: snapshot.id}) }}" data-confirm="Forget this recovery point? Disk space is reclaimed later by prune."><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="button-secondary button-danger" type="submit" {{ snapshot.snapshot_state == 'forgetting' ? 'disabled' : '' }}>Forget</button></form>
                {% endif %}
            </div>
        </div>
    {% endfor %}
    </section>
{% endif %}

{% if forgetting_count > 0 %}<div class="alert alert-warning" data-auto-refresh>Snapshot removal is running. This page will refresh automatically.</div>{% endif %}
{% endblock %}
