{% extends "layout.twig" %}

{% block title %}Applications - {{ APP.name }}{% endblock %}

{% block content %}
{% set running_count = 0 %}
{% for application in applications %}
    {% if application.status == 'running' %}{% set running_count = running_count + 1 %}{% endif %}
{% endfor %}

<header class="page-header hero-header">
    <div>
        <p class="eyebrow">Detected Docker applications</p>
        <h1>Applications</h1>
        <p class="muted">ZimaBackup groups containers by Docker Compose project so you can protect app definitions and selected volumes.</p>
    </div>
    <div class="header-actions header-actions-stacked">
        <span class="status-pill {{ discovery.status in ['ready'] ? 'ok' : (discovery.status in ['queued', 'scanning'] ? 'warning' : 'error') }}"><span class="status-dot"></span>{{ discovery.status }}</span>
        <form method="post" action="{{ ROUTER.generate('applications.refresh') }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <button class="button" type="submit">Refresh</button>
        </form>
    </div>
</header>

{% if flash_success %}<div class="alert alert-success">{{ flash_success }}</div>{% endif %}
{% if flash_error %}<div class="alert alert-error"><strong>Scan failed</strong><div>{{ flash_error }}</div></div>{% endif %}
{% if discovery.error %}<div class="alert alert-error"><strong>Discovery error</strong><div>{{ discovery.error }}</div></div>{% endif %}

<section class="stats-grid slim-stats">
    <article class="panel stat-card"><span class="stat-title">Applications</span><strong>{{ applications|length }}</strong><small>Detected projects</small></article>
    <article class="panel stat-card"><span class="stat-title">Running</span><strong>{{ running_count }}</strong><small>Healthy containers</small></article>
    <article class="panel stat-card"><span class="stat-title">Last scan</span><strong>{{ discovery.last_scan ?: 'Never' }}</strong><small>Background refresh status</small></article>
</section>

{% if applications is empty %}
    <section class="panel empty-state large-empty-state">
        <div class="empty-illustration"><span>▣</span></div>
        <h2>No applications discovered yet</h2>
        <p>Make sure the worker can access the Docker socket, then refresh application discovery.</p>
        <form method="post" action="{{ ROUTER.generate('applications.refresh') }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <button class="button" type="submit">Scan applications</button>
        </form>
    </section>
{% else %}
    <section class="card-grid app-card-grid">
        {% for application in applications %}
            {% set eligible_count = 0 %}
            {% set recommended_count = 0 %}
            {% for mount in application.mounts %}
                {% if mount.eligible %}{% set eligible_count = eligible_count + 1 %}{% endif %}
                {% if mount.recommended %}{% set recommended_count = recommended_count + 1 %}{% endif %}
            {% endfor %}
            <article class="panel app-card-v2">
                <div class="card-topline">
                    <div>
                        <span class="card-kicker">{{ application.project_name }}</span>
                        <h2>{{ application.name }}</h2>
                    </div>
                    <span class="status-pill compact {{ application.status == 'running' ? 'ok' : (application.status in ['created', 'paused', 'restarting'] ? 'warning' : 'error') }}"><span class="status-dot"></span>{{ application.status }}</span>
                </div>

                <div class="app-meta-row">
                    <span>{{ application.image }}</span>
                    <span>{{ application.container_count }} container{{ application.container_count == 1 ? '' : 's' }}</span>
                </div>

                <div class="summary-cards mini-summary-cards">
                    <article class="summary-card"><span>Recommended</span><strong>{{ recommended_count }}</strong></article>
                    <article class="summary-card"><span>Eligible</span><strong>{{ eligible_count }}</strong></article>
                    <article class="summary-card"><span>Mounts</span><strong>{{ application.mounts|length }}</strong></article>
                </div>

                <div class="mount-list">
                    {% for mount in application.mounts|slice(0, 4) %}
                        <div class="mount-row">
                            <div>
                                <strong>{{ mount.destination }}</strong>
                                <small>{{ mount.source }}</small>
                            </div>
                            <span class="mini-tag {{ mount.eligible ? (mount.recommended ? 'recommended' : 'eligible') : 'ignored' }}">
                                {{ mount.eligible ? (mount.recommended ? 'recommended' : 'eligible') : 'ignored' }}
                            </span>
                        </div>
                    {% endfor %}
                    {% if application.mounts|length > 4 %}
                        <div class="more-mounts">+ {{ application.mounts|length - 4 }} more mount{{ application.mounts|length - 4 == 1 ? '' : 's' }}</div>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </section>
{% endif %}

{% if discovery.status in ['queued', 'scanning'] %}
    <div class="refresh-banner" data-auto-refresh><span class="spinner"></span> Application discovery is running. This page will refresh automatically.</div>
{% endif %}
{% endblock %}
